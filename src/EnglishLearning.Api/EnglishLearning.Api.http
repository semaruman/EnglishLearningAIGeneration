@EnglishLearning.Api_HostAddress = http://localhost:5136

### Register
POST {{EnglishLearning.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "userName": "user",
  "password": "Passw0rd"
}

### Login
POST {{EnglishLearning.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "Passw0rd"
}

### Me
GET {{EnglishLearning.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}
