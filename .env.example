# Database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=english_learning;Username=postgres;Password=postgres

# JWT (use a long random secret in production)
Jwt__Key=DEV_ONLY_CHANGE_ME_TO_A_LONG_SECRET_KEY_32_CHARS_MIN
Jwt__Issuer=EnglishLearning
Jwt__Audience=EnglishLearning
Jwt__ExpireMinutes=10080

# OpenAI — required for Practice text generation and AI word enrichment
OPENAI_API_KEY=
OpenAI__ApiKey=
OpenAI__Model=gpt-4o-mini
OpenAI__MaxTokens=1000

# Practice limits
Practice__MaxVocabularyWords=2000
Practice__MaxGenerationRetries=3
